# =====================================================================
# Telegram Darknet Monitor Configuration Template (.env.example)
# =====================================================================

# Telegram API Credentials (Required for scraping)
# Obtain from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=darknet_monitor

# Local LLM Configuration (Ollama)
USE_LOCAL_LLM=true
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.1:8b

# Cloud LLM Fallback (OpenAI)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Custom Storage Path (Optional)
# DATA_DIR=
